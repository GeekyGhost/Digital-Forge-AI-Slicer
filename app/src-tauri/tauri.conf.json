{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Digital Forge 3D Slicer",
  "version": "0.2.0",
  "identifier": "com.grayguardforge.dforge3dslicer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Digital Forge 3D Slicer",
        "width": 1600,
        "height": 960,
        "minWidth": 1100,
        "minHeight": 700,
        "dragDropEnabled": false
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  }
}
